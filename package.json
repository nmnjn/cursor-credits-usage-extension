{
  "name": "cursor-credits-usage",
  "displayName": "Cursor Credits Usage",
  "description": "Track your Cursor AI credits usage in the Cursor IDE status bar",
  "icon": "assets/icon.png",
  "version": "0.0.6",
  "license": "MIT",
  "publisher": "nmnjn",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnjn/cursor-credits-usage-extension"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-credits-usage.refreshUsage",
        "title": "Cursor Credits Usage: Refresh Usage"
      },
      {
        "command": "cursor-credits-usage.setPollingInterval",
        "title": "Cursor Credits Usage: Set Polling Interval for Auto Refresh"
      },
      {
        "command": "cursor-credits-usage.toggleDisplayMode",
        "title": "Cursor Credits Usage: Toggle Display Mode (Cost / Percentage)"
      }
    ],
    "configuration": {
      "title": "Cursor Credits Usage",
      "properties": {
        "cursorCreditsUsage.pollIntervalMinutes": {
          "type": "number",
          "default": 3,
          "description": "How often to automatically refresh the usage data (in minutes)",
          "minimum": 1
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile --minify",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --external:vscode",
    "watch": "yarn run compile --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "22.x",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.19.5"
  }
}