{
  "name": "cursor-credits-usage",
  "displayName": "Cursor Credits Usage",
  "description": "Track your Cursor AI credits usage in the Cursor IDE status bar",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "Naman Jain",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnjn/cursor-credits-usage-extension"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-credits-usage.captureCookie",
        "title": "Cursor Credits Usage: Set Cookie"
      },
      {
        "command": "cursor-credits-usage.refreshUsage",
        "title": "Cursor Credits Usage: Refresh Usage"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}